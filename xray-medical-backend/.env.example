# Environment Configuration for X-Ray Medical Analysis
# Copy this file to .env and fill in your actual API keys

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Dataset Paths
TRAINING_DATA_PATH=./datasets/training
VALIDATION_DATA_PATH=./datasets/validation
UPLOAD_DIR=./uploads

# Application Settings
DEBUG=True
ANALYSIS_CONFIDENCE_THRESHOLD=0.7
MAX_FILE_SIZE_MB=10
SUPPORTED_FORMATS=jpg,jpeg,png,dicom

# Database Configuration
DATABASE_URL=sqlite:///./xray_analysis.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000